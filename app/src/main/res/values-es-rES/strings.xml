    <string name="setup_retry">Reintentar configuración</string>
    <string name="setup_error_fallback">No pudimos preparar croc en este momento.</string>
    <string name="setup_ready">Todo está listo. Las transferencias pueden empezar ahora.</string>
    <string name="setup_checking">Comprobando tu dispositivo y preparando el motor de transferencia.</string>
